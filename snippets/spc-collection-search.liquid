{% comment %}
  Slim product search bar for the top of collection pages (e.g. All Products).
  Submits to Shopify's standard search, limited to products.
  Uses the Space Prints design tokens from assets/space-prints-tokens.css.
{% endcomment %}
<div class="spc-collection-search page-width">
  <form action="{{ routes.search_url }}" method="get" role="search" class="spc-collection-search__form">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <label for="SpcCollectionSearch" class="visually-hidden">Search products</label>
    <input
      id="SpcCollectionSearch"
      class="spc-collection-search__input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="Search prints and canvases"
      autocomplete="off"
    >
    <button type="submit" class="spc-collection-search__button" aria-label="{{ 'general.search.search' | t }}">
      {{- 'icon-search.svg' | inline_asset_content -}}
    </button>
  </form>
</div>

<style>
  .spc-collection-search { margin-bottom: var(--spacing-2xl, 32px); }
  .spc-collection-search__form {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
  }
  .spc-collection-search__input {
    width: 100%;
    box-sizing: border-box;
    height: 48px;
    padding: 0 52px 0 var(--spacing-lg, 20px);
    background: var(--color-bg-surface, #080620);
    color: var(--color-text-primary, #F8FAFC);
    border: 1px solid var(--color-border-subtle, #94A3B8);
    border-radius: 999px;
    font-family: var(--sp-font-body, inherit);
    font-size: 1.5rem;
    -webkit-appearance: none;
    appearance: none;
  }
  .spc-collection-search__input::placeholder { color: var(--color-text-secondary, #94A3B8); }
  .spc-collection-search__input:focus {
    outline: none;
    border-color: var(--color-accent-secondary, #A78BFA);
    box-shadow: 0 0 0 2px var(--color-accent-primary, #7C3AED);
  }
  .spc-collection-search__button {
    position: absolute;
    top: 0;
    right: 4px;
    width: 44px;
    height: 48px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-text-secondary, #94A3B8);
    cursor: pointer;
  }
  .spc-collection-search__button:hover { color: var(--color-text-primary, #F8FAFC); }
  .spc-collection-search__button .svg-wrapper,
  .spc-collection-search__button svg { width: 20px; height: 20px; }
</style>
