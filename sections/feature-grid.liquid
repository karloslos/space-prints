{{ 'space-prints-components.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .feature-grid-{{ section.id }} {
    background-color: var(--color-bg-surface);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .feature-grid-{{ section.id }} .feature-grid__list {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-2xl);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media screen and (min-width: 750px) {
    .feature-grid-{{ section.id }} .feature-grid__list {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
    }
  }
{%- endstyle -%}

<div class="feature-grid-{{ section.id }}">
  <div class="page-width">
    <ul class="feature-grid__list" role="list">
      {%- for block in section.blocks -%}
        <li class="spc-feature" {{ block.shopify_attributes }}>
          <span class="spc-feature__icon" aria-hidden="true">{{ block.settings.icon | default: '✦' }}</span>
          <p class="spc-feature__title">{{ block.settings.heading }}</p>
          <p class="spc-feature__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Feature grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon glyph", "default": "✦", "info": "A single character or emoji, e.g. ✦ ✧ ★" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature heading" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Short supporting description of this feature." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [
        { "type": "feature", "settings": { "icon": "✦", "heading": "Museum-Grade Print Quality", "text": "Archival pigment inks on 310gsm fine art paper. Colours that last 100+ years." } },
        { "type": "feature", "settings": { "icon": "✧", "heading": "Real Space Photography", "text": "Every image is sourced from publicly available astronomical imagery, not stock illustration." } },
        { "type": "feature", "settings": { "icon": "◈", "heading": "Framed & Ready to Hang", "text": "Choose a frame at checkout — every print arrives ready for your wall." } },
        { "type": "feature", "settings": { "icon": "✦", "heading": "Free UK Delivery", "text": "Carefully packaged and shipped free on every order over £50." } }
      ]
    }
  ]
}
{% endschema %}
