{{ 'space-prints-components.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .featured-collections-{{ section.id }} {
    background-color: var(--color-bg-page);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .featured-collections-{{ section.id }} .featured-collections__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-xl);
    margin-top: var(--spacing-2xl);
    list-style: none;
    padding: 0;
  }
  @media screen and (min-width: 750px) {
    .featured-collections-{{ section.id }} .featured-collections__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }
  .featured-collections-{{ section.id }} .featured-collections__view-all {
    flex-shrink: 0;
  }
{%- endstyle -%}

<div class="featured-collections-{{ section.id }}">
  <div class="page-width">
    <div class="spc-section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="spc-section-header__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- unless section.settings.heading == blank -%}
          <h2 class="spc-section-header__heading">{{ section.settings.heading }}</h2>
        {%- endunless -%}
      </div>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="spc-btn spc-btn--secondary featured-collections__view-all">{{ section.settings.view_all_label | default: 'View all' }}</a>
      {%- endif -%}
    </div>

    <ul class="featured-collections__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a
            {% if block.settings.link == blank %}
              role="link" aria-disabled="true" tabindex="-1"
            {% else %}
              href="{{ block.settings.link }}"
            {% endif %}
            class="spc-collection-tile"
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  widths: '400, 600, 800, 1200',
                  loading: 'lazy'
              }}
            {%- endif -%}
            <div class="spc-collection-tile__content">
              <p class="spc-collection-tile__title">{{ block.settings.title | escape }}</p>
              {%- if block.settings.count != blank -%}
                <p class="spc-collection-tile__count">{{ block.settings.count }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "section section-featured-collections",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Browse by theme" },
    { "type": "inline_richtext", "id": "heading", "default": "Collections", "label": "Heading" },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "\"View all\" link" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "default": 3, "label": "Number of columns on desktop" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "default": "Subject", "label": "Title" },
        { "type": "text", "id": "count", "label": "Count text", "default": "00 prints" },
        { "type": "url", "id": "link", "label": "Collection link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        { "type": "tile", "settings": { "title": "Nebulae", "count": "34 prints" } },
        { "type": "tile", "settings": { "title": "Deep Field", "count": "21 prints" } },
        { "type": "tile", "settings": { "title": "Star Clusters", "count": "18 prints" } }
      ]
    }
  ]
}
{% endschema %}
